generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum SalesChannel {
  WEB
  WHATSAPP
  POS
  MOBILE
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKING
  SHIPPED
  READY_FOR_COLLECTION
  DELIVERED
  COLLECTED
  CANCELLED
  REFUNDED
}

enum FulfillmentMethod {
  DELIVERY
  COLLECTION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum StockMovementType {
  SALE
  RETURN
  RECEIVE
  ADJUST
  TRANSFER_OUT
  TRANSFER_IN
  RESERVE
  RELEASE
  COMMIT
}

enum LocationType {
  WAREHOUSE
  SHOP
  POPUP
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InboundShipmentStatus {
  ORDERED
  IN_TRANSIT
  RECEIVED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

enum WhatsappSessionState {
  WELCOME
  BROWSE
  CART
  CHECKOUT
  AWAITING_PAYMENT
  CONFIRMED
}

enum CampaignSeason {
  RAMADAN
  EID
  WINTER
  SUMMER
  EVERYDAY
}

enum ContentChannel {
  TIKTOK
  INSTAGRAM
  EMAIL
  WHATSAPP
}

enum PromoType {
  PERCENT
  FIXED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String?
  name            String
  role            UserRole  @default(CUSTOMER)
  emailVerified   Boolean   @default(false)
  gdprConsentAt   DateTime?
  marketingOptIn  Boolean   @default(false)
  whatsappOptIn   Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  wishlist        WishlistItem[]
  refreshTokens   RefreshToken[]
  returns         Return[]
  pushTokens      PushToken[]
  memberships     UserMembership[]
}

model Permission {
  id    String @id @default(uuid())
  key   String @unique
  name  String
  group String
  grants RolePermission[]
}

model Role {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String   @default("")
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  permissions RolePermission[]
  members     UserMembership[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserMembership {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
}

model Address {
  id        String  @id @default(uuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  label     String?
  line1     String
  line2     String?
  city      String
  county    String?
  eircode   String?
  country   String  @default("IE")
  isDefault Boolean @default(false)

  orders    Order[]
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Collection {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  description String?
  season      CampaignSeason       @default(EVERYDAY)
  products    ProductCollection[]
}

model Product {
  id           String             @id @default(uuid())
  slug         String             @unique
  title        String
  description  String
  care         String?
  originCountry String?
  categoryId   String
  category     Category           @relation(fields: [categoryId], references: [id])
  occasion     String?
  coverage     String?
  opacity      String?
  hijabStyle   String?
  prayerReady  Boolean            @default(false)
  published    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  variants     ProductVariant[]
  images       ProductImage[]
  collections  ProductCollection[]
  reviews      Review[]
  wishlist     WishlistItem[]
  supplierLinks SupplierProduct[]
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
}

model ProductVariant {
  id             String           @id @default(uuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String           @unique
  barcode        String?
  size           String
  color          String
  fabric         String?
  costCents      Int
  priceCents     Int
  compareAtCents Int?
  weightGrams    Int              @default(200)
  active         Boolean          @default(true)

  inventory      InventoryLevel[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  movements      StockMovement[]
  poLines        PurchaseOrderLine[]
}

model Location {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  type      LocationType
  address   String?
  active    Boolean      @default(true)

  inventory InventoryLevel[]
  movements StockMovement[]  @relation("MovementLocation")
  devices   PosDevice[]
}

model InventoryLevel {
  id           String         @id @default(uuid())
  variantId    String
  locationId   String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location     Location       @relation(fields: [locationId], references: [id])
  onHand       Int            @default(0)
  reserved     Int            @default(0)
  reorderPoint Int            @default(5)

  @@unique([variantId, locationId])
}

model StockMovement {
  id          String            @id @default(uuid())
  variantId   String
  locationId  String
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  location    Location          @relation("MovementLocation", fields: [locationId], references: [id])
  type        StockMovementType
  quantity    Int
  channel     SalesChannel?
  refId       String?
  note        String?
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([refId])
}

model Cart {
  id         String       @id @default(uuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  channel    SalesChannel @default(WEB)
  sessionKey String?
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  items      CartItem[]
  orders     Order[]

  @@index([sessionKey])
}

model CartItem {
  id         String         @id @default(uuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  quantity   Int
  reserved   Boolean        @default(false)
}

model PromoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  type       PromoType
  value      Int
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
  orders     Order[]
}

model Order {
  id              String             @id @default(uuid())
  userId          String?
  user            User?              @relation(fields: [userId], references: [id])
  cartId          String?
  cart            Cart?              @relation(fields: [cartId], references: [id])
  email           String
  name            String
  phone           String?
  status          OrderStatus        @default(PENDING_PAYMENT)
  channel         SalesChannel
  fulfillment     FulfillmentMethod  @default(DELIVERY)
  addressId       String?
  address         Address?           @relation(fields: [addressId], references: [id])
  giftNote        String?
  promoCodeId     String?
  promo           PromoCode?         @relation(fields: [promoCodeId], references: [id])
  subtotalCents   Int
  discountCents   Int                @default(0)
  shippingCents   Int                @default(0)
  taxCents        Int
  totalCents      Int
  trackingToken   String             @unique
  stripeSessionId String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  shipments       Shipment[]
  returns         Return[]
  posSale         PosSale?
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  title         String
  sku           String
  size          String
  color         String
  quantity      Int
  unitPriceCents Int
  taxCents      Int
  returnItems   ReturnItem[]
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String
  providerRef           String        @unique
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  idempotencyKey        String        @unique
  raw                   Json?
  createdAt             DateTime      @default(now())
}

model Refund {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents Int
  reason      String
  providerRef String?
  createdAt   DateTime @default(now())
}

model Shipment {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier     String?
  trackingNo  String?
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
}

model Return {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  status    ReturnStatus @default(REQUESTED)
  reason    String
  createdAt DateTime     @default(now())
  items     ReturnItem[]
}

model ReturnItem {
  id          String    @id @default(uuid())
  returnId    String
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Supplier {
  id        String            @id @default(uuid())
  name      String
  country   String
  email     String?
  phone     String?
  notes     String?
  example   Boolean           @default(true)
  products  SupplierProduct[]
  purchaseOrders PurchaseOrder[]
}

model SupplierProduct {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  moq         Int      @default(1)
  unitCostCents Int
  leadDays    Int      @default(21)

  @@unique([supplierId, productId])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        PurchaseOrderStatus @default(DRAFT)
  monthBucket   String
  currency      String              @default("EUR")
  notes         String?
  orderedAt     DateTime?
  createdAt     DateTime            @default(now())
  lines         PurchaseOrderLine[]
  shipments     InboundShipment[]
}

model PurchaseOrderLine {
  id              String         @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  unitCostCents   Int
  receivedQty     Int            @default(0)
}

model InboundShipment {
  id              String                @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  status          InboundShipmentStatus @default(ORDERED)
  tracking        String?
  shippedAt       DateTime?
  receivedAt      DateTime?
}

model WhatsappSession {
  id          String                @id @default(uuid())
  waId        String                @unique
  state       WhatsappSessionState  @default(WELCOME)
  cartId      String?
  customerId  String?
  lastMessage String?
  updatedAt   DateTime              @updatedAt
  createdAt   DateTime              @default(now())
  messages    OutboundMessage[]
}

model OutboundMessage {
  id        String           @id @default(uuid())
  sessionId String
  session   WhatsappSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  template  String?
  body      String
  createdAt DateTime         @default(now())
}

model PosDevice {
  id         String    @id @default(uuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  name       String
  externalId String?   @unique
  active     Boolean   @default(true)
}

model PosSale {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  deviceId   String?
  externalId String   @unique
  raw        Json?
  createdAt  DateTime @default(now())
}

model Campaign {
  id           String          @id @default(uuid())
  name         String
  season       CampaignSeason
  audience     String?
  landingSlug  String?
  promoCodeId  String?
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime        @default(now())
  calendar     ContentCalendarItem[]
}

model ContentCalendarItem {
  id          String         @id @default(uuid())
  campaignId  String?
  campaign    Campaign?      @relation(fields: [campaignId], references: [id])
  channel     ContentChannel
  caption     String
  assetUrl    String?
  publishOn   DateTime
  published   Boolean        @default(false)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([provider, eventId])
}
