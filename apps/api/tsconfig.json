{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "strictPropertyInitialization": false,
    "noEmit": false,
    "declaration": false
  },
  "include": ["src", "prisma/seed.ts"]
}
