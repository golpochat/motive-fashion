# Copy to apps/api/.env and apps/web/.env.local

# --- Database ---
DATABASE_URL="postgresql://motive:motive@localhost:5432/motive_fashion?schema=public"
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
API_PREFIX=api/v1
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Motive Fashion <hello@motivefashion.ie>"

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN="change-me"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# --- Square POS ---
SQUARE_ACCESS_TOKEN=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_ENVIRONMENT="sandbox"
SQUARE_LOCATION_ID=""

# --- Storage ---
S3_BUCKET=""
S3_REGION="eu-west-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Push (Expo / FCM later) ---
EXPO_ACCESS_TOKEN=""
