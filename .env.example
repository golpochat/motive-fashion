# Copy to apps/api/.env and apps/web/.env.local

# --- Database ---
DATABASE_URL="postgresql://motive:motive@127.0.0.1:5435/motive_fashion?schema=public"
REDIS_URL="redis://localhost:6379"
# AUTH_LOCKOUT_LIMIT="5"
# AUTH_LOCKOUT_WINDOW_SEC="900"

# --- API ---
API_PORT=4000
API_PREFIX=api/v1
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"
ALLOW_MOCK_PAYMENTS="true"

# Production: NODE_ENV=production, JWT_SECRET at least 32 random characters,
# ALLOW_MOCK_PAYMENTS=false, live Stripe keys + webhook, RESEND_API_KEY, HTTPS WEB_ORIGIN.
# The API and worker refuse to start in production if those are missing.
# Staff/admin authenticator is required in production unless REQUIRE_STAFF_MFA=false.
# REQUIRE_STAFF_MFA="true"
# ALLOW_HTTP_ORIGIN="true"  # local compose only; never on the public host

# Sole trader identity (leave LEGAL_NAME as the shop until you set your own name).
# LEGAL_NAME="Your Name"
# NEXT_PUBLIC_LEGAL_NAME="Your Name"
# VAT_REGISTERED="false"
# Set VAT_REGISTERED=true and VAT_NUMBER after Revenue issues a number, or prices stay euro-only (not “inc. VAT”).
# TRADER_ADDRESS="12 Example Street, Dublin 8"
# NEXT_PUBLIC_TRADER_ADDRESS="12 Example Street, Dublin 8"

# --- Stripe ---

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Email (Resend) ---
# From must be a domain verified in Resend (this shop sends from motivefashion.com).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Motive Fashion <info@motivefashion.com>"
# EMAIL_REPLY_TO="info@motivefashion.com"
RESEND_API_KEY=""
EMAIL_FROM="Motive Fashion <info@motivefashion.com>"
EMAIL_REPLY_TO="info@motivefashion.com"
CONTACT_TO="hello@motivefashion.com"

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN="motive-local-verify"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# --- Square POS ---
SQUARE_ACCESS_TOKEN=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL="http://localhost:4000/api/v1/webhooks/square"
SQUARE_ENVIRONMENT="sandbox"
SQUARE_LOCATION_ID=""

# Irish VAT number on till tickets (e.g. IE1234567T). Leave empty until Revenue issues it.
VAT_NUMBER=""

# Epson TM-T20III (USB COM on this PC, or LAN raw 9100). Leave both empty for preview-only.
POS_PRINTER_PORT="COM3"
# POS_PRINTER_HOST=""
# POS_PRINTER_TCP_PORT="9100"

# --- Storage ---
# Local uploads live in apps/api/uploads and are served at /api/v1/media.
# S3_BUCKET=""
S3_REGION="eu-west-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Web ---
NEXT_PUBLIC_API_URL="/api/v1"
API_ORIGIN="http://localhost:4000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Slack-compatible webhook for worker job failures and process crashes.
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
# LOG_LEVEL="info"
