# Copy to apps/api/.env and apps/web/.env.local

# --- Database ---
DATABASE_URL="postgresql://motive:motive@127.0.0.1:5435/motive_fashion?schema=public"
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
API_PREFIX=api/v1
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
WEB_ORIGIN="http://localhost:3000"
COOKIE_DOMAIN="localhost"
ALLOW_MOCK_PAYMENTS="true"

# Production: NODE_ENV=production, real JWT_SECRET, ALLOW_MOCK_PAYMENTS=false,
# live Stripe keys + webhook, RESEND_API_KEY, HTTPS WEB_ORIGIN.

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Motive Fashion <noreply@motivefashion.ie>"

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN="motive-local-verify"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# --- Square POS ---
SQUARE_ACCESS_TOKEN=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL="http://localhost:4000/api/v1/webhooks/square"
SQUARE_ENVIRONMENT="sandbox"
SQUARE_LOCATION_ID=""

# --- Storage ---
S3_BUCKET=""
S3_REGION="eu-west-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Web ---
NEXT_PUBLIC_API_URL="/api/v1"
API_ORIGIN="http://localhost:4000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Push (Expo / FCM later) ---
EXPO_ACCESS_TOKEN=""
